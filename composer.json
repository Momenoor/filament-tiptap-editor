{
    "name": "momenoor/filament-tiptap-editor",
    "type": "package",
    "description": "A Tiptap integration for Filament Admin/Forms.",
    "keywords": [
        "framework",
        "laravel",
        "filament",
        "tiptap",
        "wysiwyg",
        "editor"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Momen Noor",
            "email": "momen.noor@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "ueberdosis/tiptap-php": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Momenoor\\FilamentTiptapEditor\\": "src/",
            "Momenoor\\FilamentTiptapEditor\\Tests\\": "tests/src",
            "Momenoor\\FilamentTiptapEditor\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Momenoor\\FilamentTiptapEditor\\FilamentTiptapEditorServiceProvider"
            ]
        },
        "aliases": {
            "TiptapConverter": "Momenoor\\FilamentTiptapEditor\\Facades\\TiptapConverter"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php artisan package:discover --ansi",
        "pint": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
